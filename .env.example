# Anthropic API (used by CrewAI agents by default)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (optional, only needed if CREWAI_MODEL is set to an OpenAI model)
OPENAI_API_KEY=your_openai_api_key_here

# CrewAI
CREWAI_LOG_LEVEL=INFO
# Model used by the CrewAI agents. Defaults to anthropic/claude-sonnet-5.
# Examples: anthropic/claude-sonnet-5, anthropic/claude-haiku-4-5, openai/gpt-4o, openai/gpt-4o-mini
CREWAI_MODEL=anthropic/claude-sonnet-5
